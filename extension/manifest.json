{
  "manifest_version": 3,
  "name": "FlightScout",
  "version": "1.0.0",
  "description": "Capture and compare flight search results.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.skyscanner.net/*",
    "https://www.skyscanner.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlightScout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.skyscanner.net/*",
        "https://www.skyscanner.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}